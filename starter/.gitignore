*.pptx
*.ppt
*.pdf
*.docx
*.xlsx
*.xls
*.zip
*.gz
*.db
*.sqlite
*.sqlite3
*.gif
*.mp4
*.mov
*.ttf
*.otf
*.node

# Rebuildable output, caches, and temporary files.
__pycache__/
.cache/
node_modules/
.next/
dist/
build/
coverage/
*.tmp
*.temp
*~
